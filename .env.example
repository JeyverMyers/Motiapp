# ============================================================================
# Variables de entorno de Motiapp
# ============================================================================
#
# Copia este archivo a .env.local y completa los valores.
# .env.local está en .gitignore: nunca se sube.
#
# En Vercel estas mismas variables se configuran en Settings → Environment
# Variables. Las marcadas como «solo servidor» NO deben llevar el prefijo
# NEXT_PUBLIC_: con ese prefijo Next las incrusta en el bundle del navegador.
# ============================================================================


# ----------------------------------------------------------------------------
# Base de datos (Neon)
# ----------------------------------------------------------------------------
#
# DOS cadenas, con DOS roles distintos. Intercambiarlas desactiva el
# aislamiento entre negocios en silencio; la app se niega a arrancar si pasa
# (ver asegurarRolDeAplicacion en src/db/index.ts y ESTRUCTURA.md §3).
#
# DATABASE_URL              rol motiapp_app (sujeto a RLS), host con -pooler.
# DATABASE_URL_MIGRACIONES  rol dueño (neondb_owner), host directo. Solo
#                           migraciones y pruebas de integración.

DATABASE_URL="postgresql://motiapp_app:CONTRASEÑA@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_MIGRACIONES="postgresql://neondb_owner:CONTRASEÑA@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"


# ----------------------------------------------------------------------------
# Autenticación (Neon Auth)
# ----------------------------------------------------------------------------
#
# NEON_AUTH_BASE_URL: consola de Neon → Auth → Configuration.
# NEON_AUTH_COOKIE_SECRET: al menos 32 caracteres. Genera uno con:
#   openssl rand -base64 32

# Dirección pública del sitio (robots, sitemap, metadatos). En local no hace falta.
NEXT_PUBLIC_URL_SITIO=

NEON_AUTH_BASE_URL="https://ep-xxx.neonauth.us-east-2.aws.neon.tech/neondb/auth"
NEON_AUTH_COOKIE_SECRET="genera-uno-con-openssl-rand-base64-32"


# ----------------------------------------------------------------------------
# Correos (Resend) — opcional
# ----------------------------------------------------------------------------
#
# Se usa para avisos de vencimiento de empeños y para responder solicitudes de
# demo.

RESEND_API_KEY="re_xxx"
EMAIL_SOPORTE="soporte@motiapp.co"


# ----------------------------------------------------------------------------
# Tareas programadas
# ----------------------------------------------------------------------------
#
# Protege los endpoints de cron de Vercel. Vercel manda este valor en el
# encabezado Authorization: Bearer <CRON_SECRET>.
# Genera uno con: openssl rand -hex 32

CRON_SECRET="cambia-esto-por-un-secreto-largo"


# ----------------------------------------------------------------------------
# Datos de demostración (pnpm db:seed) — opcional, solo rama de desarrollo
# ----------------------------------------------------------------------------
#
# Usuarios que crea el seed. Si dejas la contraseña vacía, el seed genera una al
# azar y la imprime al terminar (guárdala: no se vuelve a mostrar).

SEED_SUPERADMIN_EMAIL="admin@motiapp.test"
SEED_SUPERADMIN_PASSWORD=""
SEED_DUENO_EMAIL="dueno@motoselrapido.test"
SEED_DUENO_PASSWORD=""


# ----------------------------------------------------------------------------
# Entorno
# ----------------------------------------------------------------------------

NODE_ENV="development"
